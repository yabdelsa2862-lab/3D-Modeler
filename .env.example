# Copy this to .env if you prefer environment variables over the UI
# (The UI saves settings to your browser's localStorage automatically)

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...

AZURE_API_KEY=...
AZURE_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_DEPLOYMENT=gpt-4o
AZURE_API_VERSION=2024-02-01

# For Local LLM (Ollama) — no key needed, just make sure Ollama is running
# ollama pull llama3.2
